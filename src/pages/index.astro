    </div>

    <header class="site-header" data-header>
      <div class="header-scrim" aria-hidden="true"></div>
      <a class="wordmark magnetic" href="#home" aria-label="Sahithi Pondugula home">
        <span class="wordmark-mark">S</span>
        <span class="wordmark-full">SAHITHI <i>PONDUGULA</i></span>
