    </header>

    <div class="mobile-menu" aria-hidden="true">
      <nav aria-label="Mobile navigation">
        <a href="#about"><em>01</em>About</a>
        <a href="#services"><em>02</em>Services</a>
        <a href="#portfolio"><em>03</em>Portfolio</a>
