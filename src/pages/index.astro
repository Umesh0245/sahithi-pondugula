---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

const images = {
  hero: '/images/hero.webp',
  about: '/images/about.webp',
  bridal: '/images/bridal.webp',
  photoshoot: '/images/photoshoot.webp',
  glam: '/images/everyday-glam.png',
  editorial: '/images/editorial.webp',
  purple: '/images/purple.webp',
  braided: '/images/braided.webp',
  closeup: '/images/closeup.webp',
  behind: '/images/behind.png',
  artist: '/images/artist.png',
  bridalGold: '/images/bridal-gold.png',
  smaEditorial: '/images/sma-editorial.png',
  glamWarm: '/images/glam-warm.png'
};

const portfolio = [
  { src: images.bridal, title: 'Bridal', category: 'Bridal', size: 'tall' },
  { src: images.bridalGold, title: 'Golden Hour Bride', category: 'Bridal', size: 'feature' },
  { src: images.smaEditorial, title: 'Pastel Editorial · SMA', category: 'Photoshoot', size: 'feature' },
  { src: images.purple, title: 'After Dark', category: 'Photoshoot', size: 'wide' },
  { src: images.closeup, title: 'Editorial Detail', category: 'Photoshoot', size: 'tall' },
  { src: images.glamWarm, title: 'Everyday Definition', category: 'Everyday Glam', size: 'square' },
  { src: images.glam, title: 'Soft Glam', category: 'Everyday Glam', size: 'portrait' },
  { src: images.about, title: 'Statement Look', category: 'Photoshoot', size: 'portrait' },
  { src: images.hero, title: 'Bridal Radiance', category: 'Bridal', size: 'feature' }
];

const testimonials = [
  { quote: 'Sahithi made me feel like the truest version of myself on my wedding day. Every detail was intentional.', name: 'Ananya R.', role: 'Bride, 2026' },
  { quote: 'The lighting on set loved her work — makeup that reads on camera without ever feeling heavy.', name: 'Karan M.', role: 'Fashion Photographer' },
  { quote: 'She listens first, then paints. My skin looked like skin, only better.', name: 'Ritu S.', role: 'Editorial Client' },
  { quote: 'Calm energy, ridiculous precision. I would not trust anyone else with my face on a big day.', name: 'Meera V.', role: 'Bride, 2025' }
];

const marquee = ['BRIDAL', 'EDITORIAL', 'GLAM', 'PHOTOSHOOT', 'PERSONAL', 'ELEGANT', 'REFINED', 'SIGNATURE'];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#390306" />
    <meta name="description" content="Sahithi Pondugula — Makeup Artist specializing in bridal, photoshoot and everyday glam makeup." />
    <meta property="og:title" content="Sahithi Pondugula — Makeup Artist" />
    <meta property="og:description" content="Refined, personalized makeup looks designed to enhance your natural features." />
    <meta property="og:image" content={images.hero} />
    <title>Sahithi Pondugula — Makeup Artist</title>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' fill='%23390306'/%3E%3Ctext x='50' y='68' font-size='62' text-anchor='middle' fill='%23f7eee0' font-family='serif'%3ES%3C/text%3E%3C/svg%3E" />
    <link rel="preload" as="image" href={images.hero} fetchpriority="high" />
    <ClientRouter />
  </head>
  <body>
    <div class="grain" aria-hidden="true"></div>
    <div class="scroll-progress" aria-hidden="true"><i></i></div>
    <div class="cursor cursor-dot" aria-hidden="true"></div>
    <div class="cursor cursor-ring" aria-hidden="true"><span>VIEW</span></div>

    <div class="loader" aria-hidden="true">
